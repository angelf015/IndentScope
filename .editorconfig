root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Match IntelliJ IDEA's formatter instead of imposing the stricter official style.
ktlint_code_style = intellij_idea
# Long test fixtures and Gradle declarations are intentionally kept on one line.
ktlint_standard_max-line-length = disabled
# Experimental wrapping rules do not match the project's existing style.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
